/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Segoe UI', Arial, sans-serif;
  color: #333;
  background: #f8f9fa;
  line-height: 1.6;
}

/* Header */
header {
  background: #2c3e50;
  color: white;
  padding: 15px 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 30px;
}

nav a {
  color: white;
  text-decoration: none;
  font-weight: 500;
  transition: 0.3s;
}

nav a:hover {
  color: #1abc9c;
}

/* Hero Section */
.hero {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
  padding: 80px 8%;
  background: white;
  min-height: 70vh;
}

.hero img {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  border: 5px solid #1abc9c;
  object-fit: cover;
}

.hero-text h1 {
  font-size: 2.8rem;
  color: #2c3e50;
}

.hero-text p {
  font-size: 1.3rem;
  color: #7f8c8d;
  margin: 10px 0 20px;
}

.btn {
  display: inline-block;
  background: #1abc9c;
  color: white;
  padding: 12px 28px;
  border-radius: 5px;
  text-decoration: none;
  font-weight: 600;
  transition: 0.3s;
}

.btn:hover {
  background: #16a085;
  transform: translateY(-2px);
}

/* About Section */
.about {
  padding: 70px 8%;
  background: #ecf0f1;
  text-align: center;
}

.about h2 {
  font-size: 2.2rem;
  margin-bottom: 30px;
  color: #2c3e50;
}

.about-content {
  display: flex;
  align-items: center;
  gap: 40px;
  max-width: 900px;
  margin: 0 auto;
  text-align: left;
}

.about-content img {
  width: 120px;
  height: 120px;
}

/* Projects Section */
.projects {
  padding: 70px 8%;
  background: white;
  text-align: center;
}

.projects h2 {
  font-size: 2.2rem;
  margin-bottom: 40px;
  color: #2c3e50;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 30px;
  max-width: 1100px;
  margin: 0 auto;
}

.project-card {
  background: #f8f9fa;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 3px 10px rgba(0,0,0,0.1);
  transition: 0.3s;
}

.project-card:hover {
  transform: translateY(-8px);
}

.project-card img {
  width: 100%;
  border-radius: 8px;
  margin-bottom: 15px;
}

/* Footer */
footer {
  background: #2c3e50;
  color: white;
  padding: 50px 8%;
  text-align: center;
}

footer h2 {
  margin-bottom: 25px;
  font-size: 2rem;
}

.contact-container {
  display: flex;
  justify-content: center;
  gap: 60px;
  flex-wrap: wrap;
}

.contact-email img {
  width: 80px;
  margin-bottom: 10px;
}

.contact-social p {
  font-size: 1.1rem;
  margin: 10px 0;
}

/* Responsive for Mobile */
@media (max-width: 768px) {
  header {
    flex-direction: column;
    gap: 10px;
  }
  
  nav ul {
    gap: 15px;
    flex-wrap: wrap;
    justify-content: center;
  }
  
  .hero {
    flex-direction: column;
    text-align: center;
    padding: 50px 5%;
  }
  
  .about-content {
    flex-direction: column;
    text-align: center;
  }
}
